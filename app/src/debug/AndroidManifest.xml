<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: start with
             adb shell am start -n ba.infotablet/.debug.SelfTestActivity -->
        <activity
            android:name=".debug.SelfTestActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen" />
        <receiver
            android:name=".debug.DebugTimeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ba.infotablet.DEBUG_TIME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
